{
  "name": "onQ",
  "version": "1.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --ext .ts,.svelte",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y/",
    "bench": "cargo bench -p onq-core",
    "tauri": "tauri",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "dev:app": "tauri dev --config crates/onq-app/tauri.conf.json",
    "build:app": "tauri build --config crates/onq-app/tauri.conf.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-svelte-csf": "^5.1.6",
    "@storybook/svelte-vite": "^10.6.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "@tsconfig/svelte": "^5.0.9",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/ui": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-plugin-storybook": "^10.6.7",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "storybook": "^10.6.7",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "typescript": "~6.0",
    "vite": "^8.3.8",
    "vitepress": "^2.0.0-alpha.21",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "bits-ui": "^2.21.0"
  },
  "overrides": {
    "keyv": "6.1.0",
    "flat-cache": "6.1.23",
    "file-entry-cache": "11.1.5",
    "cacheable-request": "13.0.19",
    "cacheable": "2.5.0",
    "cache-manager": "7.2.9",
    "@cacheable/utils": "2.5.0",
    "@cacheable/memory": "2.2.0",
    "@cacheable/node-cache": "3.1.1",
    "@cacheable/net": "2.1.0"
  }
}
